
[submodule "dotfiles"]
	path = git-submodules/dotfiles
	url = git@github.com:Korimer/dots
	branch = main
[submodule "PersonalUtilScripts"]
	path = git-submodules/PersonalUtilScripts
	url = git@github.com:Korimer/Mini-Utility-Scripts
	branch = main
[submodule "quotes"]
	path = git-submodules/quotes
	url = git@github.com:Korimer/Quotes.git
	branch = main
[submodule "impure-context"]
	path = git-submodules/impure-context
	url = ./git-submodules/impure-context/
	branch = main
	ignore = dirty
